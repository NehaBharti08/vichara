# Copy to .env and fill in what you have. Nothing here is required.
#
# Every credential below is optional by design. With an empty .env the agent
# still starts, `vichara health` still exits 0, and the full test suite still
# passes -- tools fall back to fixture backends and the agent is told to say
# what it cannot do rather than guess. Run `vichara tools` to see the
# capability set you actually have.

# ---------------------------------------------------------------------------
# Model provider
# ---------------------------------------------------------------------------

# Gemini, from https://aistudio.google.com/apikey -- free tier, no card.
# The same key VidyaRAG uses; one provider across both projects.
# Absent -> the agent starts but every model call fails with one clear error.
GOOGLE_API_KEY=

# Optional escape hatch. The free tier's requests-per-day cap is what makes a
# full eval sweep take a day or two rather than twenty minutes; this is how you
# buy that time back for ~$1 when a number is needed urgently.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Tools
# ---------------------------------------------------------------------------

# Web search, from https://tavily.com -- free tier, no card.
# Absent -> web_search serves recorded fixture responses.
TAVILY_API_KEY=

# The VidyaRAG retrieval service. Must include the scheme.
# Absent -> textbook_search serves the committed OpenStax fixture corpus.
# VIDYARAG_URL=https://nehabharti08-vidyarag.hf.space

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Which config/profiles/<name>.yaml to load. `baseline` is the frozen control.
VICHARA_PROFILE=baseline

# Override the profile's sandbox choice: pyodide | docker.
# Leave unset unless you are reproducing a CI run.
# SANDBOX_BACKEND=pyodide

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Per-session file workspaces. Gitignored; the file tool cannot escape them.
WORKSPACE_ROOT=sessions

# Response cache and graph checkpoints. Both gitignored, both regenerable.
CACHE_PATH=data/cache/llm_cache.sqlite
CHECKPOINT_PATH=data/cache/checkpoints.sqlite

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

LOG_LEVEL=INFO
# json for anything that gets collected; console for a human at a terminal.
LOG_FORMAT=console
